# Export these values in your shell before running server.py.
# This file is documentation; the app does not automatically load .env files.
NWS_USER_AGENT="LakeSurf/0.2 (you@example.com)"
APP_TIMEZONE=America/Chicago
DATABASE_URL=sqlite:///./surf.db
# Set a private shared password to enable field-report editing.
NOTES_ADMIN_PASSWORD=
# Explicit offline fixtures; never enabled as a fallback for unavailable data.
SURF_DEMO=0
# Disable network refresh for offline tests or a manually managed cache.
WEATHER_REFRESH=1
